# Supabase project (Project Settings → API). The anon/publishable key is safe to
# expose; every table is protected by row-level security.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Apex host the app is served from (include the port locally).
# Tenant sites are <slug>.<ROOT_DOMAIN>. Use lvh.me:3000 if *.localhost
# doesn't resolve in your browser (e.g. Safari).
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000

# Serve tenant sites at /sites/<slug> on the root host outside development
# (useful for preview deployments without wildcard subdomains).
# ALLOW_PATH_TENANTS=true
